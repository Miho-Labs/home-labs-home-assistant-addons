#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Labs Backup — instalacja integracji i przekazanie jej tokenu
# ==============================================================================
bashio::log.info "Uruchamianie Home Labs Backup..."

export PYTHONUNBUFFERED=1
export PYTHONPATH=/usr/src
cd /usr/src || bashio::exit.nok "Brak katalogu /usr/src"

exec python3 -m hl_backup
